# Database (local Docker — xem docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/database

# Auth (manage.dutai.site)
MANAGE_BASE_URL=https://localhost:3000
MANAGE_API_KEY=
MANAGE_AUTH_ME_PATH=/api/v1/auth/me

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Dev: bật để bỏ qua gọi manage (chỉ local)
AUTH_DEV_BYPASS=false
AUTH_DEV_USER_ID=1
AUTH_DEV_ROLE_NAME=admin

# S3-compatible object storage (dataset, submission script/model, predictions)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET_NAME=dut-ai-quiz-dev
S3_FORCE_PATH_STYLE=true

# Next.js (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MANAGE_LOGIN_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

REDIS_PORT=
HACKATHON_QUEUE_NAME=arq:hackathon
LESSON_INDEX_QUEUE_NAME=arq:lesson-index
HOMEWORK_QUEUE_NAME=arq:homework

# Google GenAI / Gemma API Key
GEMINI_API_KEY=

# Semantic search & Rerank for related lessons / questions
EMBEDDING_ENABLED=true
# dutai = textembedding.dutai.io.vn; local/openai_compatible are optional alternatives
EMBEDDING_PROVIDER=dutai
EMBEDDING_API_URL=https://textembedding.dutai.io.vn/embed
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# pgvector columns use vector(1024); changing models also requires a DB migration.
EMBEDDING_DIMENSIONS=1024
LESSON_CHUNK_TARGET_TOKENS=250
LESSON_CHUNK_MAX_TOKENS=400
RELATED_LESSON_MIN_SCORE=0.25
RELATED_QUESTION_MIN_SCORE=0.5

# Reranking (Cross-Encoder)
RERANK_ENABLED=true
RERANK_PROVIDER=dutai
RERANK_API_URL=https://textembedding.dutai.io.vn/rerank
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
