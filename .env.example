# Database (local Docker — xem docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/database

# Auth (manage.dutai.site)
MANAGE_BASE_URL=https://localhost:3000
MANAGE_AUTH_ME_PATH=/api/v1/auth/me

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Dev: bật để bỏ qua gọi manage (chỉ local)
AUTH_DEV_BYPASS=false
AUTH_DEV_USER_ID=1
AUTH_DEV_ROLE_NAME=admin

# MinIO / S3 (upload — xem docs/storage.md)
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=True
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=dut-ai-quiz-dev

# Next.js (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MANAGE_LOGIN_URL=http://localhost:3000

REDIS_PORT=

# Semantic search for related lessons (OpenAI-compatible embeddings endpoint)
EMBEDDING_ENABLED=true
# local = zero-config deterministic embedding; openai_compatible = remote API below
EMBEDDING_PROVIDER=local
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Embedding vectors are stored as PostgreSQL float arrays; keep this aligned with the provider.
EMBEDDING_DIMENSIONS=1536
RELATED_LESSON_MIN_SCORE=0.25
